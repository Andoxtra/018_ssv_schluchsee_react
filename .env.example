# Trusted browser origin; local HTTP development also accepts loopback aliases.
SITE_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
DATA_DIR=var

# Docker deployment: the public hostname. `compose.yaml` derives SITE_ORIGIN from
# this (https://$SITE_HOST) and Caddy uses it for the HTTPS certificate.
SITE_HOST=ssv-schluchsee.de

# Optional contact-form email notification. Mail is only sent when both SMTP_HOST
# and SMTP_USER are set; otherwise submissions are simply stored in the inbox.
# MAIL_FROM=info@ssv-schluchsee.de
# MAIL_TO=info@ssv-schluchsee.de
# SMTP_HOST=mail.ssv-schluchsee.de
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@ssv-schluchsee.de
# SMTP_PASS=
