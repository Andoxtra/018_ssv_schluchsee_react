# Trusted browser origin; local HTTP development also accepts loopback aliases.
SITE_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
DATA_DIR=var

# Docker deployment: the public hostname. `compose.yaml` derives SITE_ORIGIN from
# this (https://$SITE_HOST) and Caddy uses it for the HTTPS certificate.
SITE_HOST=ssv-schluchsee.de
